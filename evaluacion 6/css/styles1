*.body {
    background-color: #12161a;
    color: #ffffff;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
}
.cards-flex-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: stretch; /* Hace que todas tengan la misma altura */
    gap: 20px;
    width: 100%;
    max-width: 1200px;
    margin: 40px auto;
}
.card {
    background-color: #1c232b;
    border: 1px solid #284e49;
    border-radius: 12px;
    padding: 30px 24px;
    width: 340px; /* Ancho fijo para mantener la proporción exacta */
    
    /* Flexbox interno */
    display: flex;
    flex-direction: column;
    justify-content: space-between; 
}
.main-header h1 {
    color: #3ee2c6;
    font-size: 32px;
    text-align: center;
    margin-bottom: 5px;
}

.main-header .subtitle {
    color: #a0aec0;
    text-align: center;
    font-size: 16px;
}

.card h2 {
    color: #3ee2c6;
    font-size: 24px;
    margin-top: 0;
    margin-bottom: 15px;
}

.card p {
    color: #e2e8f0;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 25px;
}
.style-selector {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 25px;
}

.style-link {
    color: #a0aec0;
    text-decoration: none;
    font-size: 14px;
}

.style-link:first-child {
    color: #ffffff; /* Destaca la opción seleccionada */
}
.btn {
    background-color: #1c4d49;
    color: #3ee2c6;
    border: 1px solid #3ee2c6;
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 14px;
    cursor: pointer;
    align-self: flex-start; /* Evita que el botón ocupe el 100% del ancho */
}
.main-footer {
    text-align: center;
    color: #718096;
    font-size: 14px;
    margin-top: 40px;
}